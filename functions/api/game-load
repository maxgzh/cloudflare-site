export async function onRequestPost(context) {
  const { env, request } = context;
  try {
    const { username } = await request.json();
    const save = await env.DB.prepare("SELECT save_data FROM game_saves WHERE username = ?").bind(username).first();
    
    if (save) {
        return new Response(JSON.stringify({ success: true, state: JSON.parse(save.save_data) }));
    }
    return new Response(JSON.stringify({ success: false, error: "无存档" }));
  } catch (error) {
    return new Response(JSON.stringify({ success: false, error: error.message }), { status: 500 });
  }
}
